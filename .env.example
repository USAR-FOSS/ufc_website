# Required: PostgreSQL connection string the running site uses. On Neon this is the POOLED address (the host has "-pooler" in it), with the
# restricted login from ops/sql/roles.sql (ufc_app), so a leaked or buggy site cannot drop tables.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?schema=public"

# Used by the Prisma command line (migrations) only: the DIRECT address (no "-pooler") with the owner login. Falls back to DATABASE_URL.
# DIRECT_URL="postgresql://OWNER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# Optional: a read replica. Only a few reads that can be a moment old use it (the live poll's lists of who to check). Falls back to DATABASE_URL.
# DATABASE_REPLICA_URL="postgresql://USERNAME:PASSWORD@REPLICA_HOST:5432/DATABASE?schema=public"

# Optional: how many connections one server instance holds open. Default 5. Keep it small: every instance has its own.
# DATABASE_POOL_MAX=5

# On your own machine only: the host name of the PRODUCTION database. Prisma commands and the seed script refuse to run against it unless
# you put ALLOW_PRODUCTION_DB=yes in front of that one command. Do not set this on Vercel.
# PRODUCTION_DB_HOST="ep-something-pooler.ap-southeast-1.aws.neon.tech"

# Required: GitHub OAuth App credentials. Create an OAuth App at
# https://github.com/settings/developers with callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_ID="oauth-client-id"
GITHUB_SECRET="oauth-client-secret"

# Required: a random, persistent secret used to encrypt Auth.js session cookies.
# Generate one with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Required: the GitHub account ids that get the ADMIN role, separated by commas. Find yours with: gh api users/<username> --jq .id
# Admins review the events members propose.
ADMIN_GITHUB_IDS="123456"
# Older and less safe: usernames can be renamed and taken by someone else. Only used when ADMIN_GITHUB_IDS is empty.
# ADMIN_GITHUB_USERNAME="your-github-username"

# Required in production: a base64-encoded 32-byte key used to encrypt each
# user's GitHub OAuth token before it is stored for background sync jobs.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-a-base64-32-byte-key"

# Upstash Redis: versioned cache keys and SSE update coordination. This is the main database: the cache and the rate limiter.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-redis-token"

# Optional: more Redis databases, to spread the load. Everything works without them.
#  - STATE: the live poll's notes, locks and the "has to sign in again" list, kept apart from the cache.
#  - CACHE_2 to CACHE_6: extra cache databases. Each cache namespace lives on exactly one of them.
# UPSTASH_REDIS_STATE_REST_URL="https://your-state-instance.upstash.io"
# UPSTASH_REDIS_STATE_REST_TOKEN="replace-with-token"
# UPSTASH_REDIS_CACHE_2_REST_URL="https://your-second-cache-instance.upstash.io"
# UPSTASH_REDIS_CACHE_2_REST_TOKEN="replace-with-token"

# Optional tuning. Seconds a server instance may hold a cache answer in its own memory (default 5, 0 turns it off).
# CACHE_L1_SECONDS=5
# Hours without anyone on the site after which the scheduled live poll stops running, so the database can sleep (default 3, 0 turns it off).
# LIVE_POLL_IDLE_HOURS=3

# Upstash QStash: durable GitHub sync job delivery and retries.
# For local development, run `npx @upstash/qstash-cli dev` and paste the credentials it prints here, including this URL.
# Locally this is the dev server above. In production it is your account's region address, for example https://qstash-eu-central-1.upstash.io
# QSTASH_URL="http://127.0.0.1:8080"
QSTASH_TOKEN="replace-with-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="replace-with-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="replace-with-qstash-next-signing-key"

# Recommended in production, where this is the public application origin.
# NEXTAUTH_URL="https://fossclub.tech"

# Optional: enables the organization statistics endpoint. The signed-in user's
# GitHub OAuth token is used for the request; no organization token is stored.
# GITHUB_ORG="USAR-FOSS"

# Production only: the cookie domain, without a protocol or path.
# Leave unset for local development.
# COOKIE_DOMAIN="fossclub.tech"
